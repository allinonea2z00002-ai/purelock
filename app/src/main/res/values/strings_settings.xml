    <!-- Help -->
    <string name="sf_set_help_title">Help</string>
    <string name="sf_set_help_q1">What is PureLock?</string>
    <string name="sf_set_help_a1">PureLock helps you stay focused by blocking distracting apps, websites, feeds and keywords — on a timer, on a schedule, or at places you choose.</string>
    <string name="sf_set_help_q2">How do I block an app?</string>
    <string name="sf_set_help_a2">Open All Apps from the drawer, tap the app, then choose a blocking condition such as a daily usage limit or a time interval.</string>
    <string name="sf_set_help_q3">What is Strict Mode?</string>
    <string name="sf_set_help_a3">Strict Mode is the strongest lock. It blocks phone settings and uninstalling apps, including PureLock itself, until the deactivation method you chose is used.</string>
    <string name="sf_set_help_q4">How do I pause blocking?</string>
    <string name="sf_set_help_a4">Open Settings, then Pause PureLock. Blocking and monitoring stay paused until you resume them from the same place.</string>
    <string name="sf_set_help_q5">How do I block adult sites everywhere?</string>
    <string name="sf_set_help_a5">Turn on Block Adult Content, then set Private DNS on your phone to medium.kahfguard.com. Private DNS blocks adult sites in every app, not just browsers.</string>
    <string name="sf_set_help_q6">How do I back up my settings?</string>
    <string name="sf_set_help_a6">Open Backup &amp; Restore and tap Export backup. Save the JSON file somewhere safe; you can import it later on this or another phone.</string>

