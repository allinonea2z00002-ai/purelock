    <!-- Adult content -->
    <string name="adult_title">Adult content protection</string>
    <string name="adult_switch">Block adult websites</string>
    <string name="adult_vpn_why">This uses Android\'s VPN feature only to see DNS lookups on this device, so adult domains can be answered as \"not found\". Your other traffic does not pass through PureLock, nothing is sent to a PureLock server, and no certificate is installed.</string>
    <string name="adult_dns_provider">DNS provider for allowed sites</string>
    <string name="provider_system">Network default (most private)</string>
    <string name="provider_cleanbrowsing">CleanBrowsing Adult Filter (family DNS)</string>
    <string name="provider_cloudflare">Cloudflare for Families</string>
    <string name="adult_safesearch">SafeSearch</string>
    <string name="adult_safesearch_hint">Asks Google, Bing, DuckDuckGo and YouTube to use their safe modes.</string>
    <string name="adult_update_button">Update filter list</string>
    <string name="adult_blacklist">My blacklist</string>
    <string name="adult_allowlist">My allowlist</string>
    <string name="adult_limits">Limits: DNS filtering cannot stop browsers that use their own encrypted DNS (Secure DNS), another VPN or a proxy. Turn those off for full effect. PureLock tells you when the filter stops, but it cannot promise complete protection.</string>
    <string name="filter_status_running">Status: running</string>
    <string name="filter_status_stopped">Status: NOT running. Protection is off right now.</string>
    <string name="filter_status_off">Status: off</string>
