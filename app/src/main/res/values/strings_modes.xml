    <string name="sf_modes_step3_sub">Grant PureLock the required permission to enforce restrictions.</string>
    <string name="sf_modes_step3_desc">Device Admin lets PureLock enforce restrictions and prevents the app from being uninstalled while a mode is active.</string>
