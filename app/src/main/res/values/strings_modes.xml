    <string name="sf_modes_step4_done">Draw-over-apps permission granted.</string>

    <!-- Strict wizard (S06) -->
    <string name="sf_modes_strict_title">Activate Strict Mode</string>
    <string name="sf_modes_step1_strict_title">Restriction Editing</string>
    <string name="sf_modes_step1_strict_sub">Prevent changes to your restrictions.</string>
    <string name="sf_modes_restrict_all">Restrict All</string>
    <string name="sf_modes_restrict_all_desc">Editing, deleting, or loosening any restriction won\'t be allowed.</string>
    <string name="sf_modes_restrict_specific">Restrict Specific</string>
    <string name="sf_modes_restrict_specific_desc">Choose which restrictions can\'t be edited, deleted, or loosened.</string>
    <string name="sf_modes_step2_strict_title">Extra Restrictions</string>
    <string name="sf_modes_step2_strict_sub">Add additional safeguards to stay in control.</string>
