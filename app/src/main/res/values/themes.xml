<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- A. PREMIUM DARK (default) -->
    <style name="Theme.PureLock.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/dark_bg</item>
        <item name="colorPrimaryContainer">@color/neon_green_dim</item>
        <item name="colorOnPrimaryContainer">@color/neon_green</item>
        <item name="colorSecondary">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorSurfaceVariant">@color/dark_card_high</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>
        <item name="colorSurfaceContainer">@color/dark_card</item>
        <item name="colorSurfaceContainerHigh">@color/dark_card_high</item>
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/dark_outline</item>
        <item name="colorError">@color/dark_danger</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="bottomNavigationStyle">@style/Widget.PureLock.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.PureLock.Card</item>
        <item name="plCard">@color/dark_card</item>
        <item name="plCardHigh">@color/dark_card_high</item>
        <item name="plGlow">@color/neon_green</item>
        <item name="plSuccess">@color/neon_green</item>
        <item name="plWarning">@color/dark_warning</item>
        <item name="plDanger">@color/dark_danger</item>
        <item name="plTextSecondary">@color/dark_text_secondary</item>
        <item name="plAccentSoft">@color/neon_green_dim</item>
    </style>

    <!-- B. PREMIUM WHITE -->
    <style name="Theme.PureLock.White" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/emerald</item>
        <item name="colorOnPrimary">@color/white_bg</item>
        <item name="colorPrimaryContainer">@color/emerald_dim</item>
        <item name="colorOnPrimaryContainer">@color/emerald</item>
        <item name="colorSecondary">@color/white_cyan</item>
        <item name="colorOnSecondary">@color/white_bg</item>
        <item name="colorSurface">@color/white_bg</item>
        <item name="colorOnSurface">@color/white_text</item>
        <item name="colorSurfaceVariant">@color/white_card_high</item>
        <item name="colorOnSurfaceVariant">@color/white_text_secondary</item>
        <item name="colorSurfaceContainer">@color/white_surface</item>
        <item name="colorSurfaceContainerHigh">@color/white_card_high</item>
        <item name="colorOutline">@color/white_outline</item>
        <item name="colorOutlineVariant">@color/white_outline</item>
        <item name="colorError">@color/white_danger</item>
        <item name="android:colorBackground">@color/white_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white_bg</item>
        <item name="android:textColorPrimary">@color/white_text</item>
        <item name="android:textColorSecondary">@color/white_text_secondary</item>
        <item name="bottomNavigationStyle">@style/Widget.PureLock.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.PureLock.Card</item>
        <item name="plCard">@color/white_card</item>
        <item name="plCardHigh">@color/white_card_high</item>
        <item name="plGlow">@color/emerald</item>
        <item name="plSuccess">@color/emerald</item>
        <item name="plWarning">@color/white_warning</item>
        <item name="plDanger">@color/white_danger</item>
        <item name="plTextSecondary">@color/white_text_secondary</item>
        <item name="plAccentSoft">@color/emerald_dim</item>
    </style>

    <style name="Widget.PureLock.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/plCard</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.PureLock.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/plCard</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PureLock.NavIndicator</item>
    </style>

    <style name="Widget.PureLock.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/plAccentSoft</item>
    </style>

    <style name="TextAppearance.PureLock.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PureLock.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.PureLock.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/plTextSecondary</item>
    </style>
    <style name="Widget.PureLock.GreenButton" parent="Widget.Material3.Button">
        <!-- backgroundTint must be null or MaterialButton replaces the custom gradient background. -->
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#05080A</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.PureLock.DangerButton" parent="Widget.Material3.Button">
        <!-- backgroundTint must be null or MaterialButton replaces the custom background. -->
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.PureLock.TabButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
