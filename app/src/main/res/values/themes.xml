<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Stay Focused look (SPEC_STAYFOCUSED §1): light lavender-grey background,
         blue primary, green toggles, navy text. This is the DEFAULT theme. -->
    <style name="Theme.PureLock.White" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sf_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/sf_pill_active</item>
        <item name="colorOnPrimaryContainer">@color/sf_primary</item>
        <item name="colorSecondary">@color/sf_gradient_end</item>
        <item name="colorOnSecondary">@color/sf_text</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@color/sf_text</item>
        <item name="colorSurfaceVariant">@color/sf_divider</item>
        <item name="colorOnSurfaceVariant">@color/sf_muted</item>
        <item name="colorSurfaceContainer">@android:color/white</item>
        <item name="colorSurfaceContainerHigh">@color/sf_divider</item>
        <item name="colorOutline">@color/sf_divider</item>
        <item name="colorOutlineVariant">@color/sf_divider</item>
        <item name="colorError">@color/sf_red</item>
        <item name="android:colorBackground">@color/sf_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/sf_bg</item>
        <item name="android:textColorPrimary">@color/sf_text</item>
        <item name="android:textColorSecondary">@color/sf_muted</item>
        <item name="bottomNavigationStyle">@style/Widget.PureLock.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.PureLock.Card</item>
        <item name="plCard">@android:color/white</item>
        <item name="plCardHigh">@color/sf_divider</item>
        <item name="plGlow">@color/sf_primary</item>
        <item name="plSuccess">@color/sf_green</item>
        <item name="plWarning">@color/sf_warning</item>
        <item name="plDanger">@color/sf_red</item>
        <item name="plTextSecondary">@color/sf_muted</item>
        <item name="plAccentSoft">@color/sf_pill_active</item>
    </style>

    <!-- Dark variant of the same look (drawer Dark Mode toggle). -->
    <style name="Theme.PureLock.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sf_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/sf_dark_pill_active</item>
        <item name="colorOnPrimaryContainer">@color/sf_primary</item>
        <item name="colorSecondary">@color/sf_gradient_end</item>
        <item name="colorOnSecondary">@color/sf_dark_text</item>
        <item name="colorSurface">@color/sf_dark_card</item>
        <item name="colorOnSurface">@color/sf_dark_text</item>
        <item name="colorSurfaceVariant">@color/sf_dark_card_high</item>
        <item name="colorOnSurfaceVariant">@color/sf_muted</item>
        <item name="colorSurfaceContainer">@color/sf_dark_card</item>
        <item name="colorSurfaceContainerHigh">@color/sf_dark_card_high</item>
        <item name="colorOutline">@color/sf_dark_card_high</item>
        <item name="colorOutlineVariant">@color/sf_dark_card_high</item>
        <item name="colorError">@color/sf_red</item>
        <item name="android:colorBackground">@color/sf_dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/sf_dark_bg</item>
        <item name="android:textColorPrimary">@color/sf_dark_text</item>
        <item name="android:textColorSecondary">@color/sf_muted</item>
        <item name="bottomNavigationStyle">@style/Widget.PureLock.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.PureLock.Card</item>
        <item name="plCard">@color/sf_dark_card</item>
        <item name="plCardHigh">@color/sf_dark_card_high</item>
        <item name="plGlow">@color/sf_primary</item>
        <item name="plSuccess">@color/sf_green</item>
        <item name="plWarning">@color/sf_warning</item>
        <item name="plDanger">@color/sf_red</item>
        <item name="plTextSecondary">@color/sf_muted</item>
        <item name="plAccentSoft">@color/sf_dark_pill_active</item>
    </style>

    <style name="Widget.PureLock.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/plCard</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.PureLock.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/plCard</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PureLock.NavIndicator</item>
    </style>

    <style name="Widget.PureLock.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/plAccentSoft</item>
    </style>

    <style name="TextAppearance.PureLock.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PureLock.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/plTextSecondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.PureLock.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/plTextSecondary</item>
    </style>

    <!-- Blue pill button (SPEC §1.1): full-width, ~56dp, white bold text, fully rounded. -->
    <style name="Widget.PureLock.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_sf_pill_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Green ON toggles (SPEC §1.1): all switches in the reference are green when on. -->
    <style name="Widget.PureLock.GreenSwitch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/sf_switch_thumb</item>
        <item name="trackTint">@color/sf_switch_track</item>
    </style>

    <style name="Widget.PureLock.GreenButton" parent="Widget.Material3.Button">
        <!-- Kept for compatibility with older layouts; new screens use PrimaryButton. -->
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#05080A</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.PureLock.DangerButton" parent="Widget.Material3.Button">
        <!-- backgroundTint must be null or MaterialButton replaces the custom background. -->
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.PureLock.TabButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
