<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient header, purple -> blue -> cyan, heavily rounded bottom corners (SPEC §1.1). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/sf_gradient_end"
        android:centerColor="@color/sf_gradient_mid"
        android:startColor="@color/sf_gradient_start"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp" />
</shape>
