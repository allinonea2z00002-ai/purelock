<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Screen Unlocks "Session length breakdown" (S18): bucket label,
     light-cyan horizontal bar, count at the bar's right end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvSfSessionLabel"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/pbSfSessionBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_weight="1"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/sf_divider"
        android:progressTint="@color/sf_cyan_bar" />

    <TextView
        android:id="@+id/tvSfSessionCount"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
