<?xml version="1.0" encoding="utf-8"?>
<!-- Activate Lock Mode wizard (SPEC S05): 4-step accordion, Activate disabled
     until every step is done. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Gradient header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_sf_header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sf_bolt"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/sf_modes_lock_title"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_sf_circle_white20"
            android:contentDescription="@string/sf_modes_close"
            android:src="@drawable/ic_sf_close" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Step 1 — Blocking Level -->
            <LinearLayout
                android:id="@+id/step1Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/step1Number"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sf_step_circle"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/sf_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sf_modes_step1_lock_title"
                        android:textColor="@color/sf_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sf_modes_step1_lock_sub"
                        android:textColor="@color/sf_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/step1Chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sf_chevron_up" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/step1Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sf_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sf_modes_lock_app"
                            android:textColor="@color/sf_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sf_modes_lock_app_desc"
                            android:textColor="@color/sf_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swLockApp"
                        style="@style/Widget.PureLock.GreenSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/sf_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sf_modes_lock_restrict"
                            android:textColor="@color/sf_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sf_modes_lock_restrict_desc"
                            android:textColor="@color/sf_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swLockRestrict"
                        style="@style/Widget.PureLock.GreenSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/sf_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sf_modes_lock_phone"
                            android:textColor="@color/sf_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sf_modes_lock_phone_desc"
                            android:textColor="@color/sf_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swLockPhone"
                        style="@style/Widget.PureLock.GreenSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/sf_divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep1Next"
                    style="@style/Widget.PureLock.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sf_modes_next" />
            </LinearLayout>

            <!-- Step 2 — Set Password -->
            <LinearLayout
                android:id="@+id/step2Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/step2Number"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sf_step_circle"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/sf_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sf_modes_step2_lock_title"
                        android:textColor="@color/sf_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sf_modes_step2_lock_sub"
                        android:textColor="@color/sf_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/step2Chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sf_chevron_down" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/step2Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sf_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sf_pin_field"
                    android:digits="0123456789"
                    android:hint="@string/sf_modes_pin_hint"
                    android:imeOptions="actionNext"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:padding="16dp"
                    android:textColor="@color/sf_text"
                    android:textColorHint="@color/sf_muted"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etPinConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_sf_pin_field"
                    android:digits="0123456789"
                    android:hint="@string/sf_modes_pin_confirm_hint"
                    android:imeOptions="actionDone"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:padding="16dp"
                    android:textColor="@color/sf_text"
                    android:textColorHint="@color/sf_muted"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvPinError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sf_red"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePin"
                    style="@style/Widget.PureLock.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/sf_modes_pin_save" />
            </LinearLayout>

            <!-- Step 3 — Activate Device Admin -->
            <LinearLayout
                android:id="@+id/step3Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/step3Number"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sf_step_circle"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/sf_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sf_modes_step3_title"
                        android:textColor="@color/sf_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sf_modes_step3_sub"
                        android:textColor="@color/sf_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/step3Chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sf_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/step3Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sf_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sf_modes_step3_desc"
                    android:textColor="@color/sf_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvStep3Done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sf_modes_step3_done"
                    android:textColor="@color/sf_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeviceAdmin"
                    style="@style/Widget.PureLock.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/sf_modes_step3_button" />
            </LinearLayout>

            <!-- Step 4 — Draw over other apps Permission -->
            <LinearLayout
                android:id="@+id/step4Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/step4Number"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sf_step_circle"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/sf_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sf_modes_step4_title"
                        android:textColor="@color/sf_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sf_modes_step4_sub"
                        android:textColor="@color/sf_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/step4Chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sf_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/step4Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sf_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sf_modes_step4_desc"
                    android:textColor="@color/sf_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvStep4Done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/sf_modes_step4_done"
                    android:textColor="@color/sf_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlay"
                    style="@style/Widget.PureLock.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/sf_modes_step4_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Activate: grey/disabled until all 4 steps are done. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActivate"
        style="@style/Widget.PureLock.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/sf_modes_activate" />
</LinearLayout>
