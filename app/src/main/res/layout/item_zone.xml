<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup-style safe-zone row: home icon, name, detail, delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_badge"
        android:padding="8dp"
        android:src="@drawable/ic_nav_home"
        android:tint="?attr/plSuccess" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvZoneName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PureLock.Title" />

        <TextView
            android:id="@+id/tvZoneDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PureLock.Body" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZoneDelete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_delete"
        android:textColor="?attr/plDanger" />
</LinearLayout>
